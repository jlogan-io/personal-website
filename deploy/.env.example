# Copy to /srv/jlogan.io/.env on the Lightsail box and fill in.
# docker compose reads this file automatically from the compose file's directory.

# The Docker network Traefik (Pangolin stack) is attached to. The site container
# joins it so Traefik can reach it by container name.
#
# Find the exact value in the output of scripts/inspect-lightsail.sh, section
# "DOCKER NETWORKS" -- look at which network the traefik container is on.
# Commonly something like "pangolin_default".
PANGOLIN_NETWORK=CHANGEME

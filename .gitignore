# Hugo build output -- generated by CI on every push, never committed.
# Committing this was the source of the stale localhost:1313 build that used to
# live in git.
public/

# Hugo's resource cache (compiled SCSS, processed images). Regenerated on build.
resources/_gen/

# Lock file written by a running `hugo server`.
.hugo_build.lock

# macOS directory metadata.
.DS_Store

# Editor / OS noise
*.swp
*~
.idea/
.vscode/

# Inspection reports produced by scripts/inspect-*.sh -- these can contain
# hostnames and infrastructure detail, so keep them out of the repo.
*-report.txt
